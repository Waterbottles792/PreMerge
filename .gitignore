# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/

# ---- Packaging / build ----
build/
dist/
*.egg
*.egg-info/
pip-wheel-metadata/

# ---- Testing & coverage ----
.pytest_cache/
