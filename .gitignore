.premerge_cache.sqlite
# CLI --json output consumed by the GitHub Action.
premerge_report.json

# ---- Local configuration ----
# The committed premerge.config.json is the shared default; local overrides
# are personal and must not be committed.
premerge.config.local.json
.env
.env.*
!.env.example

# ---- Editors & IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
